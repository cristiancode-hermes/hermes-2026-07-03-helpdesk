{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "types": ["jest"],
    "target": "ES2022",
    "module": "preserve",
    "experimentalDecorators": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["src/**/*.spec.ts", "src/**/*.d.ts"]
}
